# ============================================================================
# Git Ignore for ESP32 PlatformIO + MQTT IoT Project
# SUP'COM Project 4: MQTT Attack & Defense
# ============================================================================

# ===========================
# PlatformIO
# ===========================
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/extensions.json
.vscode/settings.json
lib/
libdeps/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json

# ===========================
# Arduino IDE
# ===========================
*.hex
*.elf
*.bin
*.map

# ===========================
# Build Artifacts
# ===========================
*.o
*.a
*.so
*.dylib
*.dll
*.exe
build/
dist/

# ===========================
# Credentials & Secrets
# ===========================
# ⚠️ NEVER commit Wi-Fi passwords or API keys!
secrets.h
credentials.h
config_private.h
*.pem
*.key
*.crt
*.p12
*.pfx
ca_cert.h
client_cert.h
client_key.h

# ===========================
# Logs & Debug Files
# ===========================
*.log
*.txt
debug_output.txt
serial_monitor.log

# ===========================
# Operating System
# ===========================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ===========================
# Editors & IDEs
# ===========================
# VS Code
.vscode/*
!.vscode/extensions.json
.history/

# JetBrains (CLion, IntelliJ)
.idea/
*.iml
*.iws
cmake-build-*/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ===========================
# Temporary Files
# ===========================
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# ===========================
# Python (for custom scripts)
# ===========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
ENV/

# ===========================
# Node.js (if using MQTT dashboard tools)
# ===========================
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# ===========================
# Documentation Build
# ===========================
docs/_build/
*.pdf
*.docx
*.pptx

# ===========================
# Network Captures (Wireshark)
# ===========================
*.pcap
*.pcapng
*.cap

# ===========================
# Measurements & Benchmarks
# ===========================
docs/measurements/*.csv
docs/measurements/*.xlsx

# ===========================
# NOTES
# ===========================
# If you need to commit example configurations, use:
#   config_example.h
#   secrets_template.h
# Then users can copy and rename them locally.
